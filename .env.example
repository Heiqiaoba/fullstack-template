# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DB_POOL_MAX=10
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Auth (Better Auth) — 生产必须替换为强随机值：openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# 管理员用户 ID（逗号分隔）。注册后用 SELECT id FROM "user" WHERE email='...' 查询，填到这里
ADMIN_USER_IDS=

# API Docs（生产默认关闭；开启时建议设 DOCS_TOKEN）
ENABLE_DOCS=true
# DOCS_TOKEN=your-docs-access-token

# Client (Vite, exposed to browser)
VITE_API_URL=/api/v1

# Telemetry（前端埋点，用户无感；默认开启）
# VITE_TELEMETRY=false   # 关闭埋点
VITE_TELEMETRY_SAMPLE=1  # 采样率 0~1（1=全量，0.1=10%）
# VITE_TELEMETRY_DEBUG=true  # 开发环境打印事件
